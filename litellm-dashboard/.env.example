# 复制此文件为 .env，然后填入真实值
# cp .env.example .env

# --------- OpenAI API Keys ---------
# 从 https://platform.openai.com/api-keys 获取
# 注意：ChatGPT Plus 订阅 ≠ API 额度，两者是分开计费的
OPENAI_API_KEY_1=sk-your-first-account-key
OPENAI_API_KEY_2=sk-your-second-account-key

# --------- LiteLLM Master Key ---------
# 你的应用调用 LiteLLM 时用这个 key 做 bearer token
# 随便生成一个长字符串即可（建议 sk- 开头，方便识别）
# 生成命令: python -c "import secrets;print('sk-'+secrets.token_urlsafe(32))"
LITELLM_MASTER_KEY=sk-change-me-to-a-random-string
